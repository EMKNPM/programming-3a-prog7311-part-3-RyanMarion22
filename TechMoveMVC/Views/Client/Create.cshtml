@model TechMoveMVC.Models.Client

<div class="container mt-4">

    <h2 class="text-light mb-3">Create Client</h2>

    <div class="card p-4 shadow">

        <form asp-action="Create">

          
            <div class="mb-3">
                <label asp-for="Name" class="form-label text-light">Client Name</label>
                <input asp-for="Name" class="form-control" placeholder="Enter client name" />
                <span asp-validation-for="Name" class="text-danger"></span>
            </div>

          
            <div class="mb-3">
                <label asp-for="ContactDetails" class="form-label text-light">Contact Details</label>
                <input asp-for="ContactDetails" class="form-control" placeholder="Email / Phone" />
                <span asp-validation-for="ContactDetails" class="text-danger"></span>
            </div>

            
            <div class="mb-3">
                <label asp-for="Region" class="form-label text-light">Region</label>
                <input asp-for="Region" class="form-control" placeholder="e.g. Durban, Johannesburg" />
                <span asp-validation-for="Region" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-outline-light w-100">
                Save Client
            </button>

        </form>

    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}