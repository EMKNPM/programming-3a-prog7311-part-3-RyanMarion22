@model IEnumerable<TechMoveMVC.Models.ServiceRequest>

<div class="container mt-4">

    <h2>Service Requests</h2>

    <a asp-action="Create" class="btn btn-outline-light mb-3">+ Create Request</a>

    <div class="card bg-dark p-3">

        <table class="table table-dark table-striped">

            <thead>
                <tr>
                    <th>Contract</th>
                    <th>Description</th>
                    <th>Service Type</th>
                    <th>USD</th>
                    <th>ZAR</th>
                    <th>Status</th>
                </tr>
            </thead>

            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.ContractId</td>
                        <td>@item.Description</td>
                        <td>@item.ServiceType</td>
                        <td>@item.CostUSD</td>
                        <td>@item.CostZAR</td>
                        <td>@item.Status</td>
                        <td>
                            <a asp-action="Edit" asp-route-id="@item.ServiceRequestId" class="btn btn-warning btn-sm">Edit</a>
                            <a asp-action="Delete" asp-route-id="@item.ServiceRequestId" class="btn btn-danger btn-sm">Delete</a>
                        </td>
                    </tr>
                }
            </tbody>

        </table>

    </div>

</div>