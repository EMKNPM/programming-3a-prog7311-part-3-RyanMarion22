@model IEnumerable<TechMoveMVC.Models.Contract>

<div class="container mt-4">

    <h2>Contracts</h2>

    <div class="card bg-dark p-3 mb-3">
        <form method="get">

            <input name="status" class="form-control mb-2" placeholder="Status" />
            <input name="start" type="date" class="form-control mb-2" />
            <input name="end" type="date" class="form-control mb-2" />

            <button class="btn btn-outline-light">Filter</button>

        </form>
    </div>

    <a asp-action="Create" class="btn btn-outline-light mb-3">+ Create Contract</a>

    <div class="card bg-dark p-3">

        <table class="table table-dark table-striped">

            @foreach (var item in Model)
            {
                <tr>
                    <td>@item.Client?.Name</td>
                    <td>@item.Status</td>
                    <td>@item.StartDate.ToShortDateString()</td>
                    <td>@item.EndDate.ToShortDateString()</td>
                    <td>
                        @if (item.FilePath != null)
                        {
                            <a href="@item.FilePath" target="_blank">View PDF</a>
                        }
                    </td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.ContractId" class="btn btn-warning btn-sm">Edit</a>
                        <a asp-action="Delete" asp-route-id="@item.ContractId" class="btn btn-danger btn-sm">Delete</a>
                    </td>
                </tr>
            }

        </table>

    </div>

</div>