@model TechMoveMVC.Models.Contract

<h2>Edit Contract</h2>

<form asp-action="Edit">
    <input type="hidden" asp-for="ContractId" />

    <input asp-for="ClientId" class="form-control mb-2" />
    <input asp-for="Status" class="form-control mb-2" />
    <input asp-for="ServiceLevel" class="form-control mb-2" />

    <button class="btn btn-primary">Save</button>
</form>